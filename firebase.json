{
  "hosting": {
    "site": "witchbench",
    "public": "site/dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "cleanUrls": false,
    "headers": [
      {"source": "**", "headers": [
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"},
        {"key": "X-Frame-Options", "value": "DENY"},
        {"key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"}
      ]},
      {"source": "/archive/**/raw/*.html", "headers": [
        {"key": "Content-Disposition", "value": "attachment"},
        {"key": "Content-Security-Policy", "value": "sandbox; default-src 'none'"}
      ]},
      {"source": "/archive/**/pages/*.html", "headers": [
        {"key": "Content-Security-Policy", "value": "sandbox; default-src 'none'; img-src 'self' data:; style-src 'unsafe-inline'; base-uri 'none'; frame-ancestors 'none'"}
      ]},
      {"source": "/data/**", "headers": [{"key": "Cache-Control", "value": "public, max-age=300"}]},
      {"source": "/archive/**", "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]}
    ]
  }
}
