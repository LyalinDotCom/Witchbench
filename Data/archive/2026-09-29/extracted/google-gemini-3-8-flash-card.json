      "heading": "Implementation and Sustainability",
      "isFootnote": false
    },
    {
      "index": 28,
      "tag": "h3",
      "text": "Hardware",
      "heading": "Hardware",
      "isFootnote": false
    },
    {
      "index": 29,
      "tag": "p",
      "text": "Gemini 3.8 Flash is based on Gemini 3.7 Flash. For more information about the hardware for Gemini 3.8 Flash and our continued commitment to operate sustainably , see the Gemini 3.7 Flash model card .",
      "heading": "Hardware",
      "isFootnote": false
    },
    {
      "index": 30,
      "tag": "h3",
      "text": "Software",
      "heading": "Software",
      "isFootnote": false
    },
    {
      "index": 31,
      "tag": "p",
      "text": "Gemini 3.8 Flash is based on Gemini 3.7 Flash. For more information about the software for Gemini 3.8 Flash, Gemini 3.7 Flash model card .",
      "heading": "Software",
      "isFootnote": false
    },
    {
