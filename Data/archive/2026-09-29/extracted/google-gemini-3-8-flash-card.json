    },
    {
      "index": 12,
      "tag": "h3",
      "text": "Description",
      "heading": "Description",
      "isFootnote": false
    },
    {
      "index": 13,
      "tag": "p",
      "text": "Gemini 3.8 Flash is the next iteration in the Gemini 3 model family, building on Gemini 3.7 Flash, delivering performance advancements across software engineering and agentic knowledge workflows. It continues to support customizable effort levels to control the mix of quality, cost and latency.",
      "heading": "Description",
      "isFootnote": false
    },
    {
      "index": 14,
      "tag": "h3",
      "text": "Model dependencies",
      "heading": "Model dependencies",
      "isFootnote": false
    },
    {
      "index": 15,
      "tag": "p",
      "text": "Gemini 3.8 Flash is based on Gemini 3.7 Flash.",
      "heading": "Model dependencies",
      "isFootnote": false
    },
    {
      "index": 16,
      "tag": "h3",
      "text": "Inputs",
      "heading": "Inputs",
      "isFootnote": false
    },
    {
      "index": 17,
      "tag": "p",
      "text": "Text strings (e.g., a question, a prompt, document(s) to be summarized), images, audio, and video files, with a token context window of up to 1M.",
      "heading": "Inputs",
      "isFootnote": false
    },
    {
      "index": 18,
      "tag": "h3",
      "text": "Outputs",
      "heading": "Outputs",
      "isFootnote": false
    },
    {
      "index": 19,
      "tag": "p",
      "text": "Text, with a 64K token output.",
      "heading": "Outputs",
      "isFootnote": false
    },
    {
      "index": 20,
      "tag": "h3",
      "text": "Architecture",
      "heading": "Architecture",
      "isFootnote": false
    },
    {
      "index": 21,
      "tag": "p",
      "text": "Gemini 3.8 Flash is based on Gemini 3.7 Flash. For more information about the model architecture for Gemini 3.8 Flash, see the Gemini 3.7 Flash model card .",
      "heading": "Architecture",
      "isFootnote": false
    },
    {
      "index": 22,
      "tag": "h2",
      "text": "Model Data",
      "heading": "Model Data",
      "isFootnote": false
    },
    {
      "index": 23,
      "tag": "h3",
      "text": "Training Dataset",
      "heading": "Training Dataset",
      "isFootnote": false
    },
    {
      "index": 24,
      "tag": "p",
      "text": "Gemini 3.8 Flash is based on Gemini 3.7 Flash. For more information about the training dataset for Gemini 3.8 Flash, see the Gemini 3.7 Flash model card .",
      "heading": "Training Dataset",
      "isFootnote": false
    },
